// Copy to Config/Secrets.xcconfig (gitignored) and fill in. Never commit the real file.
// Get the client ID from NCP console > AI·NAVER API / Maps > Application > "Client ID",
// with the iOS bundle id `com.herezi.app` registered.
NAVER_MAPS_CLIENT_ID = your-ncp-maps-client-id

// 카카오 개발자 콘솔 > 앱 > 앱 키 > 네이티브 앱 키 (iOS 번들 ID com.herezi.app 등록, OpenID Connect 활성화).
KAKAO_NATIVE_APP_KEY = your-kakao-native-app-key
// Supabase 대시보드 > Project Settings > API. `//`는 `/$()/`로 이스케이프한다.
SUPABASE_URL = https:/$()/your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_xxx
